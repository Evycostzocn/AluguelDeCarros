@startuml
top to bottom direction
skinparam packageStyle rectangle

package "AluguelDeCarros/frontend/src" {
    artifact "main.jsx\nRotas e layout" as main
    artifact "pages.jsx\nTelas de negócio" as pages
    artifact "auth.jsx\nSessão e proteção de rotas" as auth
    artifact "ui.jsx\nComponentes e hooks" as ui
    artifact "api.js\nCliente HTTP e CSRF" as api
    artifact "style.css" as css
    main ..> pages
    main ..> auth
    main ..> ui
    main ..> css
    pages ..> auth
    pages ..> ui
    pages ..> api
    auth ..> api
    auth ..> ui
    ui ..> api : useResource
}

package "com.example.AluguelDeCarros" {
    package "controller" as controller
    package "service" as service
    package "repository" as repository
    package "model" as model
    package "dto" as dto
    package "config" as config

    controller ..> service : delega regras
    controller ..> dto : entradas e saídas
    service ..> repository : consulta / persiste / bloqueia
    service ..> model : regras de domínio
    service ..> dto : transforma dados
    repository ..> model : entidades JPA
    dto ..> model : StatusPedido na resposta
    config ..> repository : usuário ativo / carga dev
    config ..> model : perfis / carga dev
    config ..> service : identificação de perfil
}

package "Spring Security" {
    component "Filtros de segurança\nSessão, autorização, CSRF e logout" as security
}
artifact "src/main/resources/db/migration\nV1 e V2 — Flyway" as migration
database "Supabase / PostgreSQL\nschema public" as database
api ..> security : HTTP / JSON + cookie + CSRF
security ..> controller : requisições autorizadas
config ..> security : configura filtros e beans
controller ..> security : login programático / contexto
repository ..> database : JPA / JDBC
migration ..> database : estrutura versionada

note bottom of main
    Os itens do front-end são arquivos reais,
    não pastas pages/components/services.
    Vite encaminha /api a localhost:8080.
end note
note bottom of service
    ClienteService: cadastro e renda.
    IdentidadeService: usuário e perfil.
    AluguelService: pedidos, avaliação e contratos.
    Transações e bloqueios protegem mutações.
end note
note bottom of migration
    Flyway aplica migrações;
    Hibernate valida (ddl-auto=validate).
    Schema auth do Supabase não é alterado.
end note
@enduml
