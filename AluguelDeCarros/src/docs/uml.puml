@startuml
top to bottom direction
skinparam classAttributeIconSize 0

legend top left
  Modelo do código JPA atual.
  Getters e construtores omitidos para legibilidade.
  Setas indicam navegação das associações implementadas.
endlegend

abstract class Usuario {
    - id: Long
    - usuario: String
    - senhaHash: String
    - ativo: boolean
    + desativar(): void
}

class Cliente {
    - rg: String
    - cpf: String
    - nome: String
    - endereco: String
    - profissao: String
    - vinculosRenda: List<VinculoRenda>
    + atualizar(rg: String, cpf: String, nome: String, endereco: String, profissao: String): void
    + adicionarVinculoRenda(vinculo: VinculoRenda): void
    + removerVinculoRenda(vinculo: VinculoRenda): void
    + getVinculosRenda(): List<VinculoRenda>
}

class Agente {
    - nome: String
    - cnpj: String
    - tipo: TipoAgente
}

enum TipoAgente {
    EMPRESA
    BANCO
}

class VinculoRenda {
    - id: Long
    - entidadeEmpregadora: String
    - rendimento: BigDecimal
    - cliente: Cliente
    + atualizar(entidadeEmpregadora: String, rendimento: BigDecimal): void
    ~ associarA(cliente: Cliente): void
    ~ desassociarDe(cliente: Cliente): void
}

class Automovel {
    - id: Long
    - matricula: String
    - ano: int
    - marca: String
    - modelo: String
    - placa: String
    - proprietarioCliente: Cliente
    - proprietarioAgente: Agente
}

class PedidoAluguel {
    - id: Long
    - dataCriacao: LocalDateTime
    - dataInicio: LocalDate
    - dataFim: LocalDate
    - status: StatusPedido
    - cliente: Cliente
    - automovel: Automovel
    + alterar(automovel: Automovel, inicio: LocalDate, fim: LocalDate): void
    + cancelar(): void
    + avaliar(aprovada: boolean): void
    + contratar(): void
}

enum StatusPedido {
    EM_ANALISE
    APROVADO
    REPROVADO
    CANCELADO
    CONTRATADO
}

class AvaliacaoFinanceira {
    - id: Long
    - dataAvaliacao: LocalDateTime
    - parecer: String
    - aprovada: boolean
    - pedido: PedidoAluguel
    - agente: Agente
}

class ContratoAluguel {
    - id: Long
    - pedido: PedidoAluguel
    - agente: Agente
    - dataCelebracao: LocalDate
    - valor: BigDecimal
}

class ContratoCredito {
    - id: Long
    - valor: BigDecimal
    - quantidadeParcelas: Integer
    - contrato: ContratoAluguel
    - banco: Agente
}

note left of Usuario
    Herança JPA JOINED.
    usuarios centraliza o login único.
    agentes e clientes usam JOINED.
    clientes e agentes compartilham a PK de usuarios.
    Conta desativada por ativo = false.
end note

note left of VinculoRenda
    Associação bidirecional LAZY.
    Coleção exposta somente para leitura.
    Até três vínculos pelos métodos do domínio.
    Serviço bloqueia cliente durante alterações.
    orphanRemoval remove vínculos retirados.
end note

Usuario <|-- Cliente
Usuario <|-- Agente

Agente --> TipoAgente
PedidoAluguel --> StatusPedido

Cliente "1" *-- "0..3" VinculoRenda : possui
PedidoAluguel "0..*" --> "1" Cliente : cliente
PedidoAluguel "0..*" --> "1" Automovel : automovel

AvaliacaoFinanceira "0..1" --> "1" PedidoAluguel : pedido
AvaliacaoFinanceira "0..*" --> "1" Agente : agente

ContratoAluguel "0..1" --> "1" PedidoAluguel : pedido
ContratoAluguel "0..*" --> "1" Agente : agente

ContratoCredito "0..1" --> "1" ContratoAluguel : contrato
ContratoCredito "0..*" --> "1" Agente : banco

Automovel "0..*" --> "0..1" Cliente : proprietarioCliente
Automovel "0..*" --> "0..1" Agente : proprietarioAgente

note right of Agente
    Representa a conta de uma empresa
    ou de um banco participante.
end note

note right of Automovel
    Cada automóvel deve possuir exatamente
    um proprietário: Cliente ou Agente.
    As duas associações são exclusivas (CHECK SQL).
    Contratos não transferem nem copiam propriedade.
end note

note right of PedidoAluguel
    Apenas pedidos aprovados podem
    originar contratos de aluguel.

    Cada pedido terá, nesta versão,
    no máximo uma avaliação conclusiva.
end note

note right of ContratoCredito
    O agente concedente deve
    possuir o tipo BANCO.
    Identificado pela sessão, não pelo payload.
    Valores monetários: NUMERIC(15,2).
end note

@enduml
